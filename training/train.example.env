# Generic starting point for an SD1.5 face LoRA - copy to train.env and tune.
# NAME is your trigger word AND the dataset folder name; use a made-up word (e.g. "jdoeface").
NAME=myface
BASE_MODEL=runwayml/stable-diffusion-v1-5
RESOLUTION=512,512
REPEATS=8
NETWORK_DIM=16
NETWORK_ALPHA=8
UNET_LR=2e-4
TEXT_ENCODER_LR=1e-4
WARMUP_STEPS=50
BATCH_SIZE=1
EPOCHS=10
SAVE_EVERY=2
